# pnpm dev / pnpm start load the root .env automatically.
HOST=127.0.0.1
PORT=3100
REVIEW_DATABASE_PATH=./data/review.db
# Optional: 32 random bytes encoded as base64. If unset, data/master.key is created.
# REVIEW_ENCRYPTION_KEY=
# Comma-separated additional trusted browser origins, only when deploying behind your own gateway.
# REVIEW_ALLOWED_ORIGINS=https://review.example.com
