    "@nestjs/platform-express": "12.2.0",
    "@review/contracts": "workspace:*",
    "ai": "7.0.148",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "mdast-util-from-markdown": "2.1.0",
    "picomatch": "^4.0.3",
    "reflect-metadata": "^0.2.2",
